/* Cyberwave Radio · spotify-connect.js (v36)
 * Modo PREMIUM: login do OUVINTE via OAuth PKCE (sem segredo no site) + Web Playback SDK.
 * A aba da Cyberwave vira um dispositivo "Spotify Connect" e toca o áudio aqui, com DRM.
 *
 * Requisitos:
 *  - Conta Spotify Premium completa do ouvinte (Lite/Mini não funcionam).
 *  - App criado em developer.spotify.com → Client ID + Redirect URI = URL desta página.
 *  - Widevine disponível no navegador (ver testar-spotify.html).
 *  - Projeto NÃO comercial (termo do SDK).
 *
 * Uso mínimo:
 *   CyberwaveSpotify.connect.config({ clientId: 'SEU_CLIENT_ID', redirectUri: location.origin + location.pathname });
 *   await CyberwaveSpotify.connect.handleRedirect();      // chame no load da página
 *   btn.onclick = () => CyberwaveSpotify.connect.login();
 *   await CyberwaveSpotify.connect.ready();                // cria o player
 *   await CyberwaveSpotify.connect.play('spotify:chapter:ID'); // ou lista de URIs
 */
(function (global) {
  'use strict';

  const SCOPES = ['streaming', 'user-read-email', 'user-read-private', 'user-read-playback-state', 'user-modify-playback-state'];
  const LS = 'cw_spotify_auth';
  const cfg = { clientId: '', redirectUri: '', deviceName: 'Cyberwave Radio' };
  const st = { player: null, deviceId: null, ready: false, onState: () => {}, onError: () => {} };

  // ---------- PKCE ----------
  const b64url = buf => btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  function randomString(n) { const a = new Uint8Array(n); crypto.getRandomValues(a); return Array.from(a, x => ('0' + (x % 36).toString(36)).slice(-1)).join(''); }
  async function challenge(verifier) { return b64url(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(verifier))); }

  function config(o) { Object.assign(cfg, o || {}); return cfg; }
  function saved() { try { return JSON.parse(localStorage.getItem(LS) || 'null'); } catch (e) { return null; } }
  function save(t) { localStorage.setItem(LS, JSON.stringify(Object.assign({ at: Date.now() }, t))); }
  function logout() { localStorage.removeItem(LS); if (st.player) { try { st.player.disconnect(); } catch (e) {} } st.player = null; st.ready = false; st.deviceId = null; }
  function isLogged() { const s = saved(); return !!(s && s.refresh_token); }

  async function login() {
    if (!cfg.clientId || !cfg.redirectUri) throw new Error('spotify-connect: configure clientId e redirectUri');
    const verifier = randomString(64);
    sessionStorage.setItem('cw_pkce_verifier', verifier);
    const p = new URLSearchParams({
      response_type: 'code', client_id: cfg.clientId, scope: SCOPES.join(' '),
      code_challenge_method: 'S256', code_challenge: await challenge(verifier), redirect_uri: cfg.redirectUri
    });
    location.href = 'https://accounts.spotify.com/authorize?' + p.toString();
  }

  async function tokenRequest(body) {
    const r = await fetch('https://accounts.spotify.com/api/token', {
      method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(body)
    });
    if (!r.ok) throw new Error('token ' + r.status + ' ' + (await r.text()));
    return r.json();
  }

  async function handleRedirect() {
    const u = new URL(location.href);
    const code = u.searchParams.get('code');
    if (!code) return false;
    const verifier = sessionStorage.getItem('cw_pkce_verifier');
    if (!verifier) return false;
    const t = await tokenRequest({ client_id: cfg.clientId, grant_type: 'authorization_code', code, redirect_uri: cfg.redirectUri, code_verifier: verifier });
    save(t);
    sessionStorage.removeItem('cw_pkce_verifier');
    u.searchParams.delete('code'); u.searchParams.delete('state');
    history.replaceState({}, '', u.toString());
    return true;
  }

  async function accessToken() {
    const s = saved();
    if (!s) throw new Error('não logado');
    const expired = Date.now() - s.at > (s.expires_in - 60) * 1000;
    if (!expired) return s.access_token;
    const t = await tokenRequest({ client_id: cfg.clientId, grant_type: 'refresh_token', refresh_token: s.refresh_token });
    save(Object.assign({ refresh_token: s.refresh_token }, t));
    return t.access_token;
  }

  async function api(path, opts) {
    const tok = await accessToken();
    const r = await fetch('https://api.spotify.com/v1' + path, Object.assign({}, opts, {
      headers: Object.assign({ Authorization: 'Bearer ' + tok, 'Content-Type': 'application/json' }, (opts && opts.headers) || {})
    }));
    if (r.status === 204) return null;
    if (!r.ok) throw new Error('api ' + r.status + ' ' + (await r.text()));
    const ct = r.headers.get('content-type') || '';
    return ct.includes('json') ? r.json() : r.text();
  }

  async function me() { return api('/me'); }

  // ---------- Web Playback SDK ----------
  function loadSdk() {
    return new Promise((ok, bad) => {
      if (global.Spotify && global.Spotify.Player) return ok();
      global.onSpotifyWebPlaybackSDKReady = () => ok();
      const s = document.createElement('script'); s.src = 'https://sdk.scdn.co/spotify-player.js'; s.async = true;
      s.onerror = () => bad(new Error('SDK bloqueado nesta rede'));
      document.head.appendChild(s);
      setTimeout(() => (global.Spotify ? ok() : bad(new Error('SDK não inicializou'))), 15000);
    });
  }

  async function ready(opts) {
    opts = opts || {};
    st.onState = opts.onState || st.onState; st.onError = opts.onError || st.onError;
    if (st.ready) return st.deviceId;
    if (!isLogged()) throw new Error('faça login primeiro');
    await loadSdk();
    return new Promise((ok, bad) => {
      const p = new global.Spotify.Player({
        name: cfg.deviceName, volume: opts.volume != null ? opts.volume : 0.8,
        getOAuthToken: cb => accessToken().then(cb).catch(e => st.onError({ type: 'auth', message: e.message }))
      });
      p.addListener('ready', ({ device_id }) => { st.deviceId = device_id; st.ready = true; ok(device_id); });
      p.addListener('not_ready', () => { st.ready = false; });
      p.addListener('player_state_changed', s => { if (s) st.onState(s); });
      ['initialization_error', 'authentication_error', 'account_error', 'playback_error'].forEach(ev =>
        p.addListener(ev, e => { st.onError({ type: ev, message: e.message }); if (ev === 'account_error') bad(new Error('Conta sem Premium completo')); })
      );
      p.connect().then(okc => { if (!okc) bad(new Error('player não conectou')); });
      st.player = p;
      setTimeout(() => { if (!st.ready) bad(new Error('player não ficou pronto (Widevine/rede?)')); }, 20000);
    });
  }

  async function play(uris, positionMs) {
    if (!st.ready) await ready();
    const list = (Array.isArray(uris) ? uris : [uris]).filter(Boolean);
    const body = {};
    // Para audiobooks: tocar o capítulo; para show/album/playlist usar context_uri.
    if (list.length === 1 && /^spotify:(show|album|playlist|audiobook):/.test(list[0])) body.context_uri = list[0];
    else body.uris = list;
    if (positionMs) body.position_ms = positionMs;
    await api('/me/player/play?device_id=' + encodeURIComponent(st.deviceId), { method: 'PUT', body: JSON.stringify(body) });
  }
  const pause = () => st.player && st.player.pause();
  const resume = () => st.player && st.player.resume();
  const toggle = () => st.player && st.player.togglePlay();
  const nextTrack = () => st.player && st.player.nextTrack();
  const prevTrack = () => st.player && st.player.previousTrack();
  const seek = ms => st.player && st.player.seek(ms);
  const volume = v => st.player && st.player.setVolume(v);
  const getState = () => st.player ? st.player.getCurrentState() : Promise.resolve(null);

  global.CyberwaveSpotify = global.CyberwaveSpotify || {};
  global.CyberwaveSpotify.connect = { config, login, logout, isLogged, handleRedirect, me, api, ready, play, pause, resume, toggle, nextTrack, prevTrack, seek, volume, getState, get deviceId() { return st.deviceId; } };
})(window);

/* Cyberwave Radio · spotify-embed.js (v36)
 * Modo GRATUITO: usa o player oficial do Spotify (iFrame API) dentro da página.
 * - Sem login: toca preview de 30 s (audiolivros) ou episódio completo (podcasts/audiosséries).
 * - Com login no próprio embed: toca completo o que a conta do ouvinte tiver direito.
 * - Fila de capítulos: ao terminar um, carrega o próximo.
 * - Fallback: se o iframe não carregar (rede bloqueada), mostra link "Abrir no Spotify".
 *
 * Uso mínimo:
 *   CyberwaveSpotify.embed.init('#spotify-player');
 *   CyberwaveSpotify.embed.loadQueue(['spotify:episode:ID1','spotify:episode:ID2'], {title:'Audiossérie X'});
 */
(function (global) {
  'use strict';

  const IFRAME_API = 'https://open.spotify.com/embed/iframe-api/v1';
  const state = {
    ctrl: null, api: null, el: null, host: null,
    queue: [], idx: -1, meta: {}, ready: false, failed: false,
    onChange: () => {}, lastPos: 0, lastDur: 0, ended: false
  };

  // ---------- util ----------
  function parseUri(input) {
    // aceita spotify:TYPE:ID ou https://open.spotify.com/TYPE/ID?...
    if (!input) return null;
    let m = /^spotify:(track|episode|show|album|playlist|audiobook|chapter):([A-Za-z0-9]+)$/.exec(input);
    if (m) return { type: m[1], id: m[2], uri: input };
    m = /open\.spotify\.com\/(?:intl-[a-z]{2}\/)?(track|episode|show|album|playlist|audiobook|chapter)\/([A-Za-z0-9]+)/.exec(input);
    if (m) return { type: m[1], id: m[2], uri: `spotify:${m[1]}:${m[2]}` };
    return null;
  }
  function webUrl(uri) { const p = parseUri(uri); return p ? `https://open.spotify.com/${p.type}/${p.id}` : 'https://open.spotify.com/'; }
  function loadScript(src, ms) {
    return new Promise((ok, bad) => {
      if (document.querySelector(`script[src="${src}"]`)) return ok();
      const s = document.createElement('script'); s.src = src; s.async = true;
      const to = setTimeout(() => bad(new Error('timeout')), ms || 12000);
      s.onload = () => { clearTimeout(to); ok(); };
      s.onerror = () => { clearTimeout(to); bad(new Error('bloqueado')); };
      document.head.appendChild(s);
    });
  }
  function emit(evt, data) { try { state.onChange(evt, Object.assign({ index: state.idx, total: state.queue.length }, data || {})); } catch (e) {} }

  // ---------- fallback ----------
  function renderFallback(uri, msg) {
    state.failed = true;
    const url = webUrl(uri || state.queue[Math.max(state.idx, 0)]);
    state.host.innerHTML = `
      <div class="cw-sp-fallback" style="background:#131a2b;border-radius:12px;padding:16px;color:#e8ecf5;font-family:system-ui,sans-serif">
        <div style="font-weight:700;margin-bottom:6px">Spotify indisponível nesta rede</div>
        <div style="color:#8b94a8;font-size:.9rem;margin-bottom:12px">${msg || 'O player não carregou. Você pode continuar no app ou site do Spotify.'}</div>
        <a href="${url}" target="_blank" rel="noopener" style="display:inline-block;background:#1db954;color:#000;font-weight:700;padding:10px 16px;border-radius:10px;text-decoration:none">Abrir no Spotify ↗</a>
      </div>`;
    emit('fallback', { url });
  }

  // ---------- core ----------
  async function init(selector, opts) {
    opts = opts || {};
    state.host = typeof selector === 'string' ? document.querySelector(selector) : selector;
    if (!state.host) throw new Error('spotify-embed: container não encontrado');
    state.onChange = typeof opts.onChange === 'function' ? opts.onChange : () => {};
    state.height = opts.height || 352;

    try { await loadScript(IFRAME_API); }
    catch (e) { renderFallback(null, 'A rede bloqueou open.spotify.com. Use o atalho abaixo.'); return false; }

    await new Promise(res => {
      if (global.SpotifyIframeApi) return res();
      const prev = global.onSpotifyIframeApiReady;
      global.onSpotifyIframeApiReady = api => { global.SpotifyIframeApi = api; if (prev) try { prev(api); } catch (e) {} res(); };
      setTimeout(res, 15000); // não travar para sempre
    });
    if (!global.SpotifyIframeApi) { renderFallback(null, 'A API do player não respondeu.'); return false; }
    state.api = global.SpotifyIframeApi;
    return true;
  }

  function mount(uri) {
    state.host.innerHTML = '';
    state.el = document.createElement('div');
    state.host.appendChild(state.el);
    state.ready = false; state.ended = false; state.lastPos = 0; state.lastDur = 0;

    const to = setTimeout(() => { if (!state.ready) renderFallback(uri, 'O player demorou demais para carregar.'); }, 20000);

    state.api.createController(state.el, { uri, width: '100%', height: state.height }, ctrl => {
      state.ctrl = ctrl;
      ctrl.addListener('ready', () => { clearTimeout(to); state.ready = true; emit('ready', { uri }); });
      ctrl.addListener('playback_update', e => {
        const d = e && e.data ? e.data : {};
        state.lastPos = d.position || 0; state.lastDur = d.duration || 0;
        emit('progress', { position: state.lastPos, duration: state.lastDur, paused: !!d.isPaused });
        // Detecta fim do capítulo: pausado e posição ≥ 98% da duração (ou duração 0 e position zerou após tocar)
        if (d.isPaused && state.lastDur > 0 && state.lastPos >= state.lastDur * 0.98 && !state.ended) {
          state.ended = true; emit('ended', { uri });
          setTimeout(next, 600);
        }
      });
    });
  }

  function loadQueue(items, meta) {
    const uris = (Array.isArray(items) ? items : [items]).map(parseUri).filter(Boolean).map(p => p.uri);
    if (!uris.length) throw new Error('spotify-embed: nenhum URI válido');
    state.queue = uris; state.meta = meta || {}; state.idx = 0; state.failed = false;
    emit('queue', { uris, meta: state.meta });
    if (!state.api) { renderFallback(uris[0]); return; }
    mount(uris[0]);
  }

  function goTo(i, autoplay) {
    if (i < 0 || i >= state.queue.length) return false;
    state.idx = i;
    const uri = state.queue[i];
    if (state.ctrl && state.ready && !state.failed) {
      state.ended = false;
      try { state.ctrl.loadUri(uri); if (autoplay) state.ctrl.play(); } catch (e) { mount(uri); }
    } else { mount(uri); }
    emit('change', { uri });
    return true;
  }
  function next() { return goTo(state.idx + 1, true); }
  function prev() { return goTo(state.idx - 1, true); }
  function play() { if (state.ctrl) state.ctrl.play(); }
  function pause() { if (state.ctrl) state.ctrl.pause(); }
  function toggle() { if (state.ctrl) state.ctrl.togglePlay(); }
  function seek(sec) { if (state.ctrl) state.ctrl.seek(sec); }
  function current() { return { index: state.idx, uri: state.queue[state.idx], url: webUrl(state.queue[state.idx]), meta: state.meta, ready: state.ready, failed: state.failed }; }
  function destroy() { try { state.ctrl && state.ctrl.destroy(); } catch (e) {} state.ctrl = null; state.ready = false; if (state.host) state.host.innerHTML = ''; }

  global.CyberwaveSpotify = global.CyberwaveSpotify || {};
  global.CyberwaveSpotify.embed = { init, loadQueue, goTo, next, prev, play, pause, toggle, seek, current, destroy, parseUri, webUrl };
})(window);

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cyberwave · Testar Spotify neste aparelho</title>
<style>
  :root{--bg:#0b0f1a;--card:#131a2b;--ok:#2ecc71;--bad:#e74c3c;--warn:#f1c40f;--txt:#e8ecf5;--mut:#8b94a8;--acc:#1db954}
  *{box-sizing:border-box}
  body{margin:0;font-family:system-ui,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--txt);padding:24px}
  h1{font-size:1.4rem;margin:0 0 4px}
  .sub{color:var(--mut);margin-bottom:20px;font-size:.95rem}
  .grid{display:grid;gap:12px;max-width:900px}
  .t{background:var(--card);border-radius:12px;padding:14px 16px;display:grid;grid-template-columns:28px 1fr auto;gap:12px;align-items:start}
  .dot{width:16px;height:16px;border-radius:50%;background:#444;margin-top:3px}
  .dot.ok{background:var(--ok)} .dot.bad{background:var(--bad)} .dot.warn{background:var(--warn)} .dot.run{background:#3498db;animation:p 1s infinite}
  @keyframes p{50%{opacity:.3}}
  .t b{display:block;margin-bottom:2px}
  .t small{color:var(--mut)}
  .st{font-weight:600;white-space:nowrap}
  .st.ok{color:var(--ok)} .st.bad{color:var(--bad)} .st.warn{color:var(--warn)}
  button{background:var(--acc);color:#000;border:0;border-radius:10px;padding:12px 18px;font-weight:700;cursor:pointer;font-size:1rem}
  button.sec{background:#2a3350;color:var(--txt)}
  .bar{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0}
  #veredito{background:var(--card);border-left:6px solid #444;border-radius:12px;padding:16px;margin-top:8px;max-width:900px}
  #veredito.ok{border-color:var(--ok)} #veredito.bad{border-color:var(--bad)} #veredito.warn{border-color:var(--warn)}
  textarea{width:100%;max-width:900px;height:200px;background:#0a0e18;color:#cfd6e6;border:1px solid #2a3350;border-radius:10px;padding:10px;font-family:ui-monospace,Consolas,monospace;font-size:.85rem}
  #embed{max-width:900px;margin-top:10px}
</style>
</head>
<body>
<h1>Testar Spotify neste aparelho</h1>
<div class="sub">Abra esta página <b>dentro da AVD</b>. Ela verifica se o player do Spotify consegue carregar e tocar nesta rede. Nada é enviado para fora; copie o relatório e cole no chat.</div>

<div class="bar">
  <button id="btnRun">▶ Rodar teste</button>
  <button class="sec" id="btnCopy" disabled>Copiar relatório</button>
</div>

<div class="grid" id="tests"></div>
<div id="veredito" hidden></div>
<div id="embed"></div>
<h3 style="margin-top:20px">Relatório</h3>
<textarea id="rep" readonly placeholder="Rode o teste para gerar o relatório."></textarea>

<script>
(() => {
  // Episódio público de podcast (não exige login nem Premium). Troque se quiser.
  const EPISODIO_TESTE = 'spotify:episode:7makk4oTQel546B0PZlDM5';

  const T = [
    { id:'https',  nome:'Contexto seguro (HTTPS)', desc:'Embed, SDK e DRM exigem HTTPS ou localhost.' },
    { id:'iframe', nome:'iFrame API do Spotify', desc:'open.spotify.com/embed/iframe-api/v1 — base do modo gratuito.' },
    { id:'sdk',    nome:'Web Playback SDK', desc:'sdk.scdn.co/spotify-player.js — base do modo Premium.' },
    { id:'cdn',    nome:'CDN de imagens (i.scdn.co)', desc:'Capas dos livros/episódios.' },
    { id:'eme',    nome:'DRM Widevine (EME)', desc:'Obrigatório para o SDK Premium tocar áudio.' },
    { id:'perm',   nome:'Permissões autoplay / encrypted-media', desc:'Política do navegador para iframes cross-origin.' },
    { id:'play',   nome:'Embed carrega e fica pronto', desc:'Cria um player real com um episódio público e espera o evento "ready".' },
  ];

  const res = {};
  const grid = document.getElementById('tests');
  T.forEach(t => {
    const el = document.createElement('div'); el.className='t'; el.id='t_'+t.id;
    el.innerHTML = `<div class="dot"></div><div><b>${t.nome}</b><small>${t.desc}</small><div class="det" style="color:#aab3c7;font-size:.85rem;margin-top:4px"></div></div><div class="st">—</div>`;
    grid.appendChild(el);
  });

  function set(id, estado, txt, det){
    res[id] = { estado, txt, det: det||'' };
    const el = document.getElementById('t_'+id);
    el.querySelector('.dot').className = 'dot '+estado;
    const st = el.querySelector('.st'); st.className='st '+estado; st.textContent = txt;
    el.querySelector('.det').textContent = det||'';
  }
  const run = id => { const el=document.getElementById('t_'+id); el.querySelector('.dot').className='dot run'; el.querySelector('.st').textContent='testando…'; };

  function loadScript(src, ms=10000){
    return new Promise((ok, bad) => {
      const t0 = performance.now();
      const s = document.createElement('script'); s.src = src; s.async = true;
      const to = setTimeout(() => { s.remove(); bad(new Error('timeout '+ms+'ms')); }, ms);
      s.onload = () => { clearTimeout(to); ok(Math.round(performance.now()-t0)); };
      s.onerror = () => { clearTimeout(to); bad(new Error('bloqueado ou inacessível')); };
      document.head.appendChild(s);
    });
  }
  function loadImg(src, ms=8000){
    return new Promise((ok, bad) => {
      const t0 = performance.now(); const i = new Image();
      const to = setTimeout(()=>bad(new Error('timeout')), ms);
      i.onload = () => { clearTimeout(to); ok(Math.round(performance.now()-t0)); };
      i.onerror = () => { clearTimeout(to); bad(new Error('bloqueado')); };
      i.src = src + '?cb=' + Date.now();
    });
  }

  async function testar(){
    document.getElementById('btnRun').disabled = true;
    document.getElementById('btnCopy').disabled = true;
    document.getElementById('veredito').hidden = true;
    document.getElementById('embed').innerHTML = '';

    // 1) HTTPS
    run('https');
    const secure = window.isSecureContext;
    set('https', secure?'ok':'bad', secure?'OK':'FALHA', location.protocol + '//' + location.host);

    // 2) iFrame API
    run('iframe');
    let iframeApiOk = false;
    try {
      const ms = await loadScript('https://open.spotify.com/embed/iframe-api/v1');
      iframeApiOk = true; set('iframe','ok','OK', ms+' ms');
    } catch(e){ set('iframe','bad','FALHA', e.message); }

    // 3) SDK
    run('sdk');
    let sdkOk = false;
    try {
      window.onSpotifyWebPlaybackSDKReady = window.onSpotifyWebPlaybackSDKReady || (()=>{});
      const ms = await loadScript('https://sdk.scdn.co/spotify-player.js');
      sdkOk = true; set('sdk','ok','OK', ms+' ms');
    } catch(e){ set('sdk','bad','FALHA', e.message); }

    // 4) CDN
    run('cdn');
    try {
      const ms = await loadImg('https://i.scdn.co/image/ab67616d0000b273e8b066f70c206551210d902b');
      set('cdn','ok','OK', ms+' ms');
    } catch(e){ set('cdn','warn','BLOQUEADA', 'Capas não aparecem; áudio pode tocar mesmo assim.'); }

    // 5) EME / Widevine
    run('eme');
    try {
      if(!navigator.requestMediaKeySystemAccess) throw new Error('API EME ausente');
      const cfg = [{ initDataTypes:['cenc'], audioCapabilities:[{contentType:'audio/mp4; codecs="mp4a.40.2"'}] }];
      await navigator.requestMediaKeySystemAccess('com.widevine.alpha', cfg);
      set('eme','ok','OK','com.widevine.alpha disponível');
    } catch(e){ set('eme','bad','FALHA', 'Sem Widevine: modo Premium (SDK) não toca. Embed pode funcionar. ' + e.message); }

    // 6) Permissions policy
    run('perm');
    try {
      const fp = document.featurePolicy || document.permissionsPolicy;
      if(!fp) { set('perm','warn','N/D','Navegador não expõe featurePolicy; o embed decide sozinho.'); }
      else {
        const a = fp.allowsFeature('autoplay'), em = fp.allowsFeature('encrypted-media');
        set('perm', (a&&em)?'ok':'warn', (a&&em)?'OK':'PARCIAL', `autoplay=${a} encrypted-media=${em}`);
      }
    } catch(e){ set('perm','warn','N/D', e.message); }

    // 7) Embed real
    run('play');
    if(!iframeApiOk){ set('play','bad','FALHA','iFrame API não carregou.'); }
    else {
      await new Promise(done => {
        const to = setTimeout(()=>{ set('play','bad','TIMEOUT','Player não ficou pronto em 20 s (iframe bloqueado?).'); done(); }, 20000);
        const start = () => {
          const el = document.createElement('div'); document.getElementById('embed').appendChild(el);
          window.SpotifyIframeApi.createController(el, { uri: EPISODIO_TESTE, width:'100%', height:152 }, ctrl => {
            ctrl.addListener('ready', () => {
              clearTimeout(to);
              set('play','ok','OK','Player pronto. Clique em ▶ no embed para confirmar som (não precisa de login para episódio).');
              done();
            });
            ctrl.addListener('playback_update', e => {
              if(e?.data?.position > 0) set('play','ok','TOCANDO', 'Posição '+Math.round(e.data.position/1000)+' s — áudio passa nesta rede.');
            });
          });
        };
        if(window.SpotifyIframeApi) start();
        else window.onSpotifyIframeApiReady = api => { window.SpotifyIframeApi = api; start(); };
      });
    }

    veredito();
    relatorio();
    document.getElementById('btnRun').disabled = false;
    document.getElementById('btnCopy').disabled = false;
  }

  function veredito(){
    const v = document.getElementById('veredito'); v.hidden = false;
    const embedOk = res.iframe?.estado==='ok' && res.play?.estado==='ok';
    const premiumOk = embedOk && res.sdk?.estado==='ok' && res.eme?.estado==='ok';
    if(premiumOk){ v.className='ok'; v.innerHTML='<b>✅ Tudo liberado.</b> Dá para usar o <b>Embed</b> (gratuito) e o <b>modo Premium</b> (Web Playback SDK) na Cyberwave nesta rede.'; }
    else if(embedOk){ v.className='warn'; v.innerHTML='<b>🟡 Só o Embed.</b> O player do Spotify toca, mas o SDK Premium não (SDK ou Widevine bloqueado). Use <code>spotify-embed.js</code> e esconda o botão "Conectar Spotify" na AVD.'; }
    else { v.className='bad'; v.innerHTML='<b>🔴 Spotify não passa nesta rede.</b> Mantenha a aba como atalhos (deep link) na AVD e habilite o player só fora da empresa.'; }
  }

  function relatorio(){
    const linhas = [
      '=== Cyberwave · Teste Spotify ===',
      'Data: ' + new Date().toISOString(),
      'URL: ' + location.href,
      'UA: ' + navigator.userAgent,
      ''
    ];
    T.forEach(t => { const r = res[t.id]||{}; linhas.push(`[${(r.txt||'—').padEnd(9)}] ${t.nome}${r.det?' — '+r.det:''}`); });
    linhas.push('', 'Veredito: ' + document.getElementById('veredito').textContent.trim());
    document.getElementById('rep').value = linhas.join('\n');
  }

  document.getElementById('btnRun').onclick = testar;
  document.getElementById('btnCopy').onclick = async () => {
    await navigator.clipboard.writeText(document.getElementById('rep').value);
    document.getElementById('btnCopy').textContent = 'Copiado ✓';
    setTimeout(()=>document.getElementById('btnCopy').textContent='Copiar relatório', 2000);
  };
})();
</script>
